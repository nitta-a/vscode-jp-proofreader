{
  "name": "vscode-jp-proofreader",
  "displayName": "JP Proofreader",
  "description": "Japanese proofreading extension for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:jp-proofreader.check"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jp-proofreader.check",
        "title": "JP Proofreader: Check"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
