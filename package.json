{
  "name": "vscode-jp-proofreader",
  "displayName": "JP Proofreader",
  "description": "Japanese proofreading extension for VS Code",
  "version": "0.0.4",
  "icon": "images/icon.png",
  "publisher": "nitta-a",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/vscode-jp-proofreader"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.22.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jp-proofreader.check",
        "title": "JP Proofreader: Check"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jp-proofreader-container",
          "title": "JP Proofreader",
          "icon": "images/activity-icon.svg"
        }
      ]
    },
    "views": {
      "jp-proofreader-container": [
        {
          "type": "tree",
          "id": "jp-proofreader-view",
          "name": "JP Proofreader"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jp-proofreader-view",
        "contents": "JP Proofreaderを使用して、現在のドキュメントの校閲を開始します。\n[校閲を開始する](command:jp-proofreader.check)"
      }
    ],
    "chatParticipants": [
      {
        "id": "jp-proofreader.proofreader",
        "name": "proofreader",
        "description": "日本語テキストの校閲を行います。テキストを入力してください。",
        "isSticky": false
      }
    ],
    "configuration": {
      "title": "JP Proofreader Settings",
      "properties": {
        "jp-proofreader.enableLogs": {
          "type": "boolean",
          "default": false,
          "description": "Output detailed [LOG] messages to the console for debugging purposes."
        },
        "vscode-jp-proofreader.allowedModelPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["gpt-4o", "gpt-4", "sonnet", "opus", "pro", "o1", "o3"],
          "description": "校閲に使用を許可するモデルを識別するための正規表現パターンの一覧（大文字小文字を区別しない）。除外リストに該当しないモデルのうち、このリストのいずれかにマッチするモデルが選択候補として表示されます。"
        },
        "vscode-jp-proofreader.excludedModelPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["mini", "flash", "haiku", "nano"],
          "description": "校閲への使用から除外するモデルを識別するための正規表現パターンの一覧（大文字小文字を区別しない）。このリストのいずれかにマッチするモデルは、許可リストの設定にかかわらず表示されません。"
        },
        "vscode-jp-proofreader.customRules": {
          "type": "string",
          "default": "",
          "description": "プロジェクト固有の校閲ルールや用語集を指定します。",
          "editPresentation": "multilineText"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint ./src ./test",
    "lint:fix": "biome lint --write ./src ./test",
    "format": "biome format ./src ./test",
    "format:fix": "biome format --write ./src ./test",
    "test": "vscode-test",
    "vsce:pre-package": "vsce package --pre-release --no-dependencies",
    "vsce:package": "vsce package",
    "vsce:pre-publish": "vsce publish --pre-release --no-dependencies",
    "vsce:publish": "vsce publish",
    "in": "code --install-extension ",
    "inf": "code --force --install-extension ",
    "p": "npm run package && npm run vsce:package"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.x",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "diff": ">8.0.2",
    "serialize-javascript": ">7.0.4"
  },
  "dependencies": {
    "@shoelace-style/shoelace": "^2.20.1",
    "lit": "^3.3.2"
  }
}
